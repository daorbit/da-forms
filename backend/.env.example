PORT=8081
NODE_ENV=development
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Notification emails (form submission confirmations). Leave blank to disable sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="daorbit2k25@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="daorbit2k25@gmail.com"
SMTP_FROM_NAME="Forms"

# Plan limits. Both must be set for limits to apply — unset, forms are unlimited.
# The secret must match FORMS_SERVICE_SECRET in the Quantalog backend.
QUANTALOG_API_URL="https://quantalog-be.daorbit.in"
FORMS_SERVICE_SECRET="a-long-random-shared-secret"

# Secret the Cloudflare cron worker must send as `Authorization: Bearer <secret>`.
CRON_SECRET=

# Minutes an unclaimed upload may survive before the sweep deletes it.
UPLOAD_GRACE_MINUTES=5
ENCRYPTION_KEY="ajshdkjashdakj"
PAYMENT_GRACE_MINUTES="30"

# Cloudflare Turnstile secret — the server half, paired with the frontend's
# VITE_TURNSTILE_SITE_KEY from the same widget. Unset means a form with
# "require a captcha" on renders no challenge and submissions are accepted
# normally, rather than every respondent being turned away.
CLOUDFLARE_SECRET_KEY=

# Where the public form lives, origin only, no trailing slash. The one URL the
# backend has to build rather than receive — an edit link is emailed after the
# response has already gone out, so there is no request to infer it from.
# Locally this is the Vite dev server, not the API.
PUBLIC_FORM_BASE_URL="http://localhost:3001"

# Signs the links that let a respondent reopen their own submission. Must be
# its own value — sharing it with any other secret means leaking one exposes
# both. Generate with `openssl rand -hex 32`.
EDIT_TOKEN_SECRET=
# How long such a link stays usable.
EDIT_WINDOW_DAYS=7

# How long a half-filled form is kept before the sweep deletes it.
PARTIAL_RETENTION_DAYS=30
