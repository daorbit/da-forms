PORT=8081
NODE_ENV=development
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Notification emails (form submission confirmations). Leave blank to disable sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="daorbit2k25@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="daorbit2k25@gmail.com"
SMTP_FROM_NAME="Forms"

# Plan limits. Both must be set for limits to apply — unset, forms are unlimited.
# The secret must match FORMS_SERVICE_SECRET in the Quantalog backend.
QUANTALOG_API_URL="https://quantalog-be.daorbit.in"
FORMS_SERVICE_SECRET="a-long-random-shared-secret"
