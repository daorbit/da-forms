VITE_API_URL=/api

# Cloudflare Turnstile site key — the public half, from the same widget whose
# secret goes in the backend's CLOUDFLARE_SECRET_KEY. Both or neither: without
# this no challenge renders, and the server accepts submissions unchallenged.
# Baked in at build time, so Vercel needs it set before the build runs.
VITE_TURNSTILE_SITE_KEY=
